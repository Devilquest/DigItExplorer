<UserControl x:Class="DigItExplorer.App.Views.LayersPane"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:DigItExplorer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LayersViewModel}">

    <DockPanel Margin="0,8,0,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="LayersFilterBox" Padding="6,2,24,2"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Search Layers">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SearchPlaceholderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=LayersFilterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="LayersClearButton" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                    ToolTip="Clear"
                    Command="{Binding ClearFilterCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, ElementName=LayersFilterBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource SmallToolbarButtonStyle}" Command="{Binding ExpandAllCommand}" ToolTip="Expand All">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4,5.5 L7,2.5 L10,5.5 M4,8.5 L7,11.5 L10,8.5" />
            </Button>
            <Button Style="{StaticResource SmallToolbarButtonStyle}" Command="{Binding CollapseAllCommand}" ToolTip="Collapse All">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4,2.5 L7,5.5 L10,2.5 M4,11.5 L7,8.5 L10,11.5" />
            </Button>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,8,2" />
            <Button Style="{StaticResource SmallToolbarButtonStyle}" Command="{Binding SelectAllCommand}" ToolTip="Select All">
                <Path Width="12" Height="12" Stretch="None"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M1.5,1.5 H10.5 V10.5 H1.5 Z M3.6,6.1 L5.3,8 L8.6,3.9" />
            </Button>
            <Button Style="{StaticResource SmallToolbarButtonStyle}" Command="{Binding DeselectAllCommand}" ToolTip="Deselect All">
                <Path Width="12" Height="12" Stretch="None"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.1" StrokeLineJoin="Round"
                      Data="M1.5,1.5 H10.5 V10.5 H1.5 Z" />
            </Button>
        </StackPanel>

        <TreeView x:Name="LayersTree" FontSize="12" BorderThickness="0" Background="Transparent"
                  ItemsSource="{Binding Items}"
                  ItemTemplate="{StaticResource LayerNodeTemplate}"
                  ItemContainerStyle="{StaticResource LayerNodeContainerStyle}" />
    </DockPanel>
</UserControl>
