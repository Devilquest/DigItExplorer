<UserControl x:Class="DigItExplorer.App.Views.AudioTransport"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DigItExplorer.App.Converters"
             xmlns:viewModels="clr-namespace:DigItExplorer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AudioPlayerViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel x:Name="AudioTransportBar" Orientation="Horizontal" HorizontalAlignment="Center"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button x:Name="AudioPlayPauseButton" Width="44" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseTooltip}">
            <Grid>
                <Path Width="10" Height="10" Stretch="Uniform"
                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M3,2 L13,8 L3,14 Z" />
                <Path Width="10" Height="10" Stretch="Uniform"
                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M2,2 H5 V14 H2 Z M9,2 H12 V14 H10 Z" />
            </Grid>
        </Button>
        <Button Width="34" Margin="6,0,0,0" Command="{Binding StopCommand}" ToolTip="Stop">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="M2,2 H14 V14 H2 Z" />
        </Button>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <Slider x:Name="AudioSeekSlider" Width="240" VerticalAlignment="Center"
                Minimum="0" Maximum="{Binding SeekMax}" IsMoveToPointEnabled="True"
                ValueChanged="AudioSeekSlider_ValueChanged" />
        <TextBlock x:Name="AudioTimeText" Text="{Binding TimeText}" Width="130" Margin="10,0,0,0"
                   TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <ToggleButton x:Name="AudioLoopToggle" Style="{StaticResource ToolbarToggleButtonStyle}" Width="34"
                      IsChecked="{Binding IsLoop, Mode=TwoWay}"
                      ToolTip="Loop">
            <Path Width="13" Height="13" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="{StaticResource RepeatIconGeometry}" />
        </ToggleButton>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <Button x:Name="AudioMuteButton" Width="34" Command="{Binding ToggleMuteCommand}"
                ToolTip="{Binding MuteTooltip}">
            <Grid>
                <Path Width="12" Height="12" Stretch="Uniform"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M2,6 H5 L9,2 V14 L5,10 H2 Z M11,5 C12.2,5.8 12.2,10.2 11,11 M13,3 C15.5,4.8 15.5,11.2 13,13" />
                <Path Width="12" Height="12" Stretch="Uniform"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibilityConverter}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M2,6 H5 L9,2 V14 L5,10 H2 Z M11.5,6.5 L14.5,9.5 M14.5,6.5 L11.5,9.5" />
            </Grid>
        </Button>
        <Slider x:Name="AudioVolumeSlider" Width="90" Margin="6,0,0,0" VerticalAlignment="Center"
                Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" IsMoveToPointEnabled="True"
                ToolTip="Volume" />
    </StackPanel>
</UserControl>
