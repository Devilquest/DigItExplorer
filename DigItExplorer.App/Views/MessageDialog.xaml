<views:DialogWindow x:Class="DigItExplorer.App.Views.MessageDialog"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItExplorer.App.Views"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="20,18,20,16" MaxWidth="420">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" IsCancel="True"
                    MinWidth="88" Padding="12,4" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Visibility="Collapsed"
                    MinWidth="88" Padding="12,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
