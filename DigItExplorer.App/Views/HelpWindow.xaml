<views:DialogWindow x:Class="DigItExplorer.App.Views.HelpWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItExplorer.App.Views"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    Title="Dig It! Explorer User Guide"
                    Width="900" Height="680" SizeToContent="Manual"
                    MinWidth="560" MinHeight="380"
                    WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="False"
                    Background="{DynamicResource RegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                    TextOptions.TextFormattingMode="Display"
                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                    Style="{x:Null}">

    <!-- CaptionHeight must match the title row (32). GlassFrameThickness enables OS window drop shadow. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <views:DialogWindow.Resources>
        <Style x:Key="ContentsItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Resources>
                <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource SelectionColor}" />
                <SolidColorBrush x:Key="DarkDefaultBrush" Color="{DynamicResource SelectionColor}" />
                <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{DynamicResource HoverColor}" />
            </Style.Resources>
        </Style>
    </views:DialogWindow.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- Inset layout by system frame margin (8px) when maximized to prevent clipping. -->
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                            <Setter Property="Margin" Value="8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Top" Height="32"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" IsHitTestVisible="False"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource MenuHeaderBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="12,0,8,0" />

                    <!-- Maximize button hit-testing is handled via CaptionButtonHitTest for Windows 11 Snap Layouts. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource MaximizeRestoreButtonStyle}">
                            <Path Style="{StaticResource MaximizeRestoreIconPathStyle}" />
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Path Style="{StaticResource CloseCaptionIconPathStyle}" Data="{StaticResource CloseIconGeometry}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" MinWidth="160" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="ContentsTree" ItemsSource="{Binding Contents}"
                              ItemContainerStyle="{StaticResource ContentsItemStyle}"
                              Background="Transparent" BorderThickness="0" Padding="4,8,4,8"
                              FontSize="12"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="Contents_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3,6,3" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Background="Transparent" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,8,12,4">
                        <Button Content="−" Width="30" Click="ZoomOut_Click" ToolTip="Zoom Out" />
                        <TextBlock x:Name="ZoomText" Text="100%" MinWidth="54" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Button Content="+" Width="30" Click="ZoomIn_Click" ToolTip="Zoom In" />
                    </StackPanel>

                    <!-- Style="{x:Null}" clears HandyControl's default zoom toolbar to prevent duplicate controls. -->
                    <FlowDocumentScrollViewer x:Name="Reader" Grid.Row="1"
                                              Style="{x:Null}"
                                              Document="{Binding Document}"
                                              Background="{DynamicResource RegionBrush}"
                                              IsSelectionEnabled="True"
                                              hc:ScrollViewerAttach.AutoHide="False"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</views:DialogWindow>
