<views:DialogWindow x:Class="DigItExplorer.App.Views.ToolsWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItExplorer.App.Views"
                    xmlns:converters="clr-namespace:DigItExplorer.App.Converters"
                    xmlns:core="clr-namespace:DigItExplorer.Core.Ui;assembly=DigItExplorer.Core"
                    Title="Dig It! Toolset"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <views:DialogWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </views:DialogWindow.Resources>

    <StackPanel Margin="24,20,24,18" MaxWidth="460">
        <TextBlock Text="Dig It! Toolset" FontSize="20"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="{x:Static core:DigItTools.HeaderLead}" /><Hyperlink Style="{StaticResource CreditLinkStyle}"
                              NavigateUri="{x:Static core:DigItTools.AuthorProfile}"
                              ToolTip="{x:Static core:DigItTools.AuthorProfile}"
                              RequestNavigate="Link_RequestNavigate"><Run Text="{x:Static core:DigItTools.Author}" /></Hyperlink><Run Text="{x:Static core:DigItTools.HeaderEnd}" /></TextBlock>

        <ItemsControl Margin="0,18,0,0" ItemsSource="{x:Static core:DigItTools.All}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14"
                                       Visibility="{Binding IsThisApp, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                <Hyperlink Style="{StaticResource RepoLinkStyle}"
                                           NavigateUri="{Binding Link}"
                                           ToolTip="{Binding Link}"
                                           RequestNavigate="Link_RequestNavigate"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                            </TextBlock>

                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding IsThisApp, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Border Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>

                            <TextBlock FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource LinkHoverBrush}"
                                       Visibility="{Binding IsThisApp, Converter={StaticResource BoolToVisibilityConverter}}"><Run Text="← " /><Run Text="{x:Static core:DigItTools.HereMarker}" /></TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="OK" IsDefault="True" IsCancel="True"
                MinWidth="88" Padding="12,4" Margin="0,8,0,0"
                HorizontalAlignment="Right" />
    </StackPanel>
</views:DialogWindow>
