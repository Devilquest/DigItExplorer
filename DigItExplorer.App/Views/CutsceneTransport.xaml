<UserControl x:Class="DigItExplorer.App.Views.CutsceneTransport"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DigItExplorer.App.Converters"
             xmlns:viewModels="clr-namespace:DigItExplorer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:CutscenePlayerViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel x:Name="CutsceneTransportBar" Orientation="Horizontal" HorizontalAlignment="Center"
                Visibility="{Binding HasClip, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button Width="34" Command="{Binding StepBackCommand}" IsEnabled="{Binding CanStepBack}" ToolTip="Previous Frame">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="M0,2 H2 V14 H0 Z M14,2 L4,8 L14,14 Z" />
        </Button>
        <Button x:Name="CutscenePlayPauseButton" Width="44" Margin="6,0,0,0" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseTooltip}">
            <Grid>
                <Path Width="10" Height="10" Stretch="Uniform"
                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M3,2 L13,8 L3,14 Z" />
                <Path Width="10" Height="10" Stretch="Uniform"
                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M2,2 H5 V14 H2 Z M9,2 H12 V14 H10 Z" />
            </Grid>
        </Button>
        <Button Width="34" Margin="6,0,0,0" Command="{Binding StepForwardCommand}" IsEnabled="{Binding CanStepForward}" ToolTip="Next Frame">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="M2,2 L12,8 L2,14 Z M14,2 H16 V14 H14 Z" />
        </Button>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <Slider x:Name="CutsceneFrameSlider" Width="240" VerticalAlignment="Center"
                Minimum="0" Maximum="{Binding TotalIterations}" IsMoveToPointEnabled="True"
                ValueChanged="CutsceneFrameSlider_ValueChanged" />
        <TextBlock x:Name="CutsceneFrameText" Text="{Binding FrameText}" Width="110" Margin="10,0,0,0"
                   TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <ToggleButton x:Name="CutsceneLoopToggle" Style="{StaticResource ToolbarToggleButtonStyle}" Width="34"
                      IsChecked="{Binding IsLoop, Mode=TwoWay}"
                      ToolTip="Loop">
            <Path Width="13" Height="13" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="{StaticResource RepeatIconGeometry}" />
        </ToggleButton>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
        <ComboBox x:Name="CutsceneSpeedBox" Width="76" Style="{StaticResource TransportSpeedBoxStyle}" ItemsSource="{Binding SpeedLabels}" SelectedIndex="{Binding SpeedIndex, Mode=TwoWay}"
                  ToolTip="Playback Speed (1× = Game Speed)" />
    </StackPanel>
</UserControl>
