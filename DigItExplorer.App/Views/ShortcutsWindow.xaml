<views:DialogWindow x:Class="DigItExplorer.App.Views.ShortcutsWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DigItExplorer.App.Views"
                    xmlns:core="clr-namespace:DigItExplorer.Core.Ui;assembly=DigItExplorer.Core"
                    Title="Keyboard Shortcuts"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="24,20,24,18" MaxWidth="420">
        <TextBlock Text="Keyboard Shortcuts" FontSize="20"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <TextBlock Text="Quick keyboard access to controls and navigation across the application." TextWrapping="Wrap"
                   FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <ItemsControl Margin="0,18,0,0" Grid.IsSharedSizeScope="True"
                      ItemsSource="{x:Static core:Shortcuts.Help}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource CodeBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource EmphasisBrush}" />
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Does}" TextWrapping="Wrap"
                                   FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Single-letter shortcuts are disabled while typing in a filter field. Shortcuts cannot be customized." />

        <Button Content="OK" IsDefault="True" IsCancel="True"
                MinWidth="88" Padding="12,4" Margin="0,16,0,0"
                HorizontalAlignment="Right" />
    </StackPanel>
</views:DialogWindow>
