<UserControl x:Class="DigItExplorer.App.Views.AnimationTransport"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DigItExplorer.App.Converters"
             xmlns:models="clr-namespace:DigItExplorer.App.Models"
             xmlns:viewModels="clr-namespace:DigItExplorer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:AnimationPlayerViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <StackPanel x:Name="AnimTransportBar" Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="{Binding IsTransportVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Width="34" Command="{Binding StepBackCommand}" IsEnabled="{Binding CanControlPlayback}" ToolTip="Previous Frame">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M0,2 H2 V14 H0 Z M14,2 L4,8 L14,14 Z" />
            </Button>
            <Button x:Name="PlayPauseButton" Width="44" Margin="6,0,0,0"
                    Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanControlPlayback}" ToolTip="{Binding PlayPauseTooltip}">
                <Grid>
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                          Data="M3,2 L13,8 L3,14 Z" />
                    <Path Width="10" Height="10" Stretch="Uniform"
                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                          Data="M2,2 H5 V14 H2 Z M9,2 H12 V14 H10 Z" />
                </Grid>
            </Button>
            <Button Width="34" Margin="6,0,0,0" Command="{Binding StepForwardCommand}" IsEnabled="{Binding CanControlPlayback}" ToolTip="Next Frame">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M2,2 L12,8 L2,14 Z M14,2 H16 V14 H14 Z" />
            </Button>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
            <TextBlock x:Name="AnimFrameText" Text="{Binding FrameText}"
                       Margin="8,0" TextAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
            <ToggleButton x:Name="AnimLoopToggle" Style="{StaticResource ToolbarToggleButtonStyle}" Width="34"
                          IsChecked="{Binding IsLoop, Mode=TwoWay}" IsEnabled="{Binding CanControlPlayback}"
                          ToolTip="Loop">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="{StaticResource RepeatIconGeometry}" />
            </ToggleButton>
            <ToggleButton x:Name="AnimBgToggle" Style="{StaticResource ToolbarToggleButtonStyle}" Width="34" Margin="6,0,0,0"
                          IsChecked="{Binding ShowCheckerboardBackdrop, Mode=TwoWay}"
                          ToolTip="Checkerboard Background">
                <Path Width="10" Height="10" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                      Data="M0,0 H2 V2 H0 Z M4,0 H6 V2 H4 Z M8,0 H10 V2 H8 Z M2,2 H4 V4 H2 Z M6,2 H8 V4 H6 Z M0,4 H2 V6 H0 Z M4,4 H6 V6 H4 Z M8,4 H10 V6 H8 Z M2,6 H4 V8 H2 Z M6,6 H8 V8 H6 Z M0,8 H2 V10 H0 Z M4,8 H6 V10 H4 Z M8,8 H10 V10 H8 Z" />
            </ToggleButton>
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,4" />
            <ComboBox x:Name="AnimSpeedBox" Width="76" Style="{StaticResource TransportSpeedBoxStyle}" ItemsSource="{Binding SpeedLabels}" SelectedIndex="{Binding SpeedIndex, Mode=TwoWay}"
                      IsEnabled="{Binding CanControlPlayback}" ToolTip="Playback Speed (1× = Game Speed)" />
            <Button Padding="10,0" Margin="6,0,0,0" Command="{Binding RegenerateCommand}"
                    Visibility="{Binding CanRegenerate, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Generate New Random Sequence">
                <TextBlock Text="Regenerate" FontSize="11" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <Border x:Name="AnimTimelineBar" Margin="0,8,0,0"
                Visibility="{Binding IsTimelineVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AnimTimeline" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TimelineStep}">
                            <Border Margin="2" Padding="3" CornerRadius="3" Cursor="Hand"
                                    BorderThickness="2" MouseLeftButtonDown="TimelineStep_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Image Source="{Binding Thumb}" Height="48" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock Text="{Binding FrameId}" HorizontalAlignment="Center"
                                               FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
