<UserControl x:Class="DigItExplorer.App.Views.PreviewStage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:DigItExplorer.App.Converters"
             xmlns:viewModels="clr-namespace:DigItExplorer.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PanelViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="InfoBar" Grid.Column="0" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock x:Name="InfoTextBlock" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Border>

            <StackPanel x:Name="ZoomToolbar" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Content="−" Width="30" Click="ZoomOut_Click" ToolTip="Zoom Out (Ctrl + -)" />
                <TextBlock x:Name="ZoomText" Text="100%" MinWidth="54" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                <Button Content="+" Width="30" Click="ZoomIn_Click" ToolTip="Zoom In (Ctrl + +)" />
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,4" />
                <Button Click="Fit_Click" ToolTip="Fit to View (0)" Width="30" Padding="0">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M3,6 L3,3 L6,3 M10,3 L13,3 L13,6 M3,10 L3,13 L6,13 M10,13 L13,13 L13,10" />
                </Button>
                <Button Content="1:1" Padding="10,0" Margin="6,0,0,0" Click="Original_Click" ToolTip="Original Size, 100% (1)" />
                <Border x:Name="TogglePanelSeparator" Width="1" Background="{DynamicResource BorderBrush}" Margin="8,4"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ToggleButton x:Name="TogglePanelButton" Content="Side Panel" Padding="10,0" ToolTip="{Binding PanelToggleTooltip}"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="{Binding IsPanelVisible, Mode=TwoWay}"
                              Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ImageScroll" Background="Transparent"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScroll_MouseLeftButtonDown"
                          PreviewMouseMove="ImageScroll_MouseMove"
                          PreviewMouseLeftButtonUp="ImageScroll_MouseLeftButtonUp"
                          SizeChanged="ImageScroll_SizeChanged">
                <Border x:Name="StageBackdrop" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="PreviewImage" Stretch="Fill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </ScrollViewer>

            <TextBox x:Name="TextPreview" Visibility="Collapsed" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                     BorderThickness="0" Background="Transparent"
                     TextAlignment="Center" VerticalContentAlignment="Center"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

            <TextBlock x:Name="EmptyHint" Text="Select a resource" IsHitTestVisible="False"
                       Foreground="{DynamicResource ThirdlyTextBrush}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel x:Name="NoGameHint" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No game folder selected" FontSize="20"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select the Dig It! game folder to get started." FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock FontSize="14" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Hyperlink Style="{StaticResource AppHyperlinkStyle}"
                               Click="OpenGameFolderLink_Click">File &gt; Open Game Folder…</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="FrameToolbar" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,0">
            <RepeatButton Content="◀" Width="34" Click="PrevFrame_Click" ToolTip="Previous Frame" Delay="400" Interval="43" />
            <TextBlock x:Name="FrameText" Text="Frame 1 of 1" MinWidth="110" Margin="8,0" TextAlignment="Center"
                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <RepeatButton Content="▶" Width="34" Click="NextFrame_Click" ToolTip="Next Frame" Delay="400" Interval="43" />
        </StackPanel>
    </Grid>
</UserControl>

