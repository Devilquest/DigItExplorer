<Window x:Class="DigItExplorer.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DigItExplorer.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Dig It! Explorer"
        Icon="/Assets/AppIcon.ico"
        MinWidth="900" MinHeight="600"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource RegionBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="UserGuide_Executed" />
    </Window.CommandBindings>

    <!-- CaptionHeight must match the title bar height (32). GlassFrameThickness enables OS window drop shadow. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource CheckerDarkBrush}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource CheckerLightBrush}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- Inset layout by system frame margin (8px) when maximized to prevent clipping. -->
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                            <Setter Property="Margin" Value="8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/AppIcon.png" Width="16" Height="16" Margin="10,0,4,0"
                           VerticalAlignment="Center" />

                    <Menu x:Name="MainMenu" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                          VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          PreviewMouseDown="MainMenu_PreviewMouseDown">
                        <MenuItem Header="_File" Style="{StaticResource TitleBarMenuItemStyle}">
                            <MenuItem Header="_Open Game Folder…" InputGestureText="Ctrl + O"
                                      Style="{StaticResource TitleBarMenuItemStyle}"
                                      Command="{Binding OpenGameFolderCommand}" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="_Export…" InputGestureText="Ctrl + E"
                                      Style="{StaticResource TitleBarMenuItemStyle}"
                                      Command="{Binding Export.ExportCommand}" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="_Close Game Folder" Style="{StaticResource TitleBarMenuItemStyle}"
                                      Command="{Binding CloseGameFolderCommand}" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="E_xit" Style="{StaticResource TitleBarMenuItemStyle}"
                                      Click="Exit_Click" />
                        </MenuItem>
                        <MenuItem Header="_Help" Style="{StaticResource TitleBarMenuItemStyle}">
                            <!-- Uses Click handler because menu popup visual tree does not route window commands. -->
                            <MenuItem Header="_User Guide" InputGestureText="F1"
                                      Style="{StaticResource TitleBarMenuItemStyle}"
                                      Click="UserGuide_Click" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="_Keyboard Shortcuts" Style="{StaticResource TitleBarMenuItemStyle}"
                                      Click="Shortcuts_Click" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="Dig It! _Toolset" Style="{StaticResource TitleBarMenuItemStyle}"
                                      Click="Tools_Click" />
                            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
                            <MenuItem Header="_About" Style="{StaticResource TitleBarMenuItemStyle}"
                                      Click="About_Click" />
                        </MenuItem>
                    </Menu>

                    <TextBlock Grid.Column="2" IsHitTestVisible="False"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource MenuHeaderBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Maximize button hit-testing is handled via CaptionButtonHitTest for Windows 11 Snap Layouts. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Minimize"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Path Style="{StaticResource CaptionIconPathStyle}" Data="{StaticResource MinimizeIconGeometry}" />
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource MaximizeRestoreButtonStyle}">
                            <Path Style="{StaticResource MaximizeRestoreIconPathStyle}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <Path Style="{StaticResource CloseCaptionIconPathStyle}" Data="{StaticResource CloseIconGeometry}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource StatusBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,5">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Text="{Binding StatusText}" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="300" Background="{DynamicResource RegionBrush}"
                        Visibility="{Binding HasGameFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:NavigationPane x:Name="NavigationPaneControl" />
                </Border>

                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <views:PreviewStage x:Name="PreviewStageControl" Grid.Row="0" Grid.RowSpan="2" />

                    <views:AnimationTransport x:Name="AnimationTransportControl" Grid.Row="2" Grid.RowSpan="2" Margin="0,8,0,0" />
                    <views:AudioTransport x:Name="AudioTransportControl" Grid.Row="2" Margin="0,8,0,0" />
                    <views:StoryTransport x:Name="StoryTransportControl" Grid.Row="2" Margin="0,8,0,0" />
                    <views:CutsceneTransport x:Name="CutsceneTransportControl" Grid.Row="2" Margin="0,8,0,0" />
                </Grid>

                <Border x:Name="SidePanel" Grid.Column="2" Visibility="Collapsed"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <TabControl Style="{StaticResource PanelTabControl}"
                                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                        <TabItem Header="Layers" Style="{StaticResource PanelTabItem}"
                                 Visibility="{Binding IsLayersTabAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <views:LayersPane x:Name="LayersPaneControl" />
                        </TabItem>
                        <TabItem Header="Info" Style="{StaticResource PanelTabItem}"
                                 Visibility="{Binding Info.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <views:InfoPane x:Name="InfoPaneControl" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
