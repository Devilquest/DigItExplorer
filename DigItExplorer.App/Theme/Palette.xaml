<!-- Literal palette colors referenced by Brushes.xaml, shared verbatim by the Dig It! desktop tools:
     a note naming a screen names the tool that has it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Surfaces ============================ -->

    <!-- Menu popup background and border. -->
    <Color x:Key="MenuPopupColor">#1F1F1F</Color>
    <Color x:Key="MenuPopupBorderColor">#454545</Color>

    <Color x:Key="TabInactiveColor">#141414</Color>
    <Color x:Key="PanelColor">#1B1B1B</Color>
    <Color x:Key="StatusBarColor">#1B1B1B</Color>
    <Color x:Key="HoverColor">#272727</Color>
    <Color x:Key="TitleBarHoverColor">#2A2A2A</Color>
    <Color x:Key="SelectionColor">#333333</Color>

    <!-- Transparency checkerboard squares for Explorer's preview stage. -->
    <Color x:Key="CheckerDarkColor">#3C3C43</Color>
    <Color x:Key="CheckerLightColor">#4C4C55</Color>

    <!-- Neutral tone behind Explorer's composed screens wherever no layer paints. -->
    <Color x:Key="StageBlankColor">#202020</Color>

    <!-- The Patcher's log panel, and inline and fenced code blocks in Explorer's user guide. -->
    <Color x:Key="CodeBackgroundColor">#1F1F1F</Color>

    <!-- Callout quote bar in Explorer's user guide. -->
    <Color x:Key="QuoteBarColor">#4A4A4A</Color>

    <!-- ============================== Text ============================== -->

    <Color x:Key="EmphasisColor">#CCCCCC</Color>
    <Color x:Key="MenuHeaderColor">#CCCCCC</Color>
    <Color x:Key="MutedIconColor">#888888</Color>

    <!-- Hyperlink resting and hover text tones. -->
    <Color x:Key="LinkColor">#CCCCCC</Color>
    <Color x:Key="LinkHoverColor">#6EA8FF</Color>

    <!-- Translucent tint for checked toggle buttons on Explorer's toolbars. -->
    <Color x:Key="ToggleCheckedFillColor">#15FFFFFF</Color>

    <!-- Floating info bar overlay on Explorer's preview stage. -->
    <Color x:Key="StageOverlayColor">#CC141414</Color>

    <!-- ========================== Fixed colors ========================== -->

    <!-- Title bar close button hover fill and glyph tone. -->
    <Color x:Key="CaptionCloseColor">#E81123</Color>
    <Color x:Key="CaptionCloseIconColor">#FFFFFF</Color>

    <!-- Hover tone for the author link in the About and Dig It! Toolset windows. -->
    <Color x:Key="AuthorLinkHoverColor">#00E143</Color>

    <!-- Heart in the About window author attribution. -->
    <Color x:Key="HeartColor">#E74C3C</Color>

    <!-- ======================= Control-theme keys ======================= -->

    <!-- Focus, selection, and checked accent for native controls. -->
    <Color x:Key="PrimaryColor">#5E5E68</Color>
    <Color x:Key="DarkPrimaryColor">#5E5E68</Color>

    <!-- Window background, title bar, and side panels. -->
    <Color x:Key="RegionColor">#141414</Color>
    <Color x:Key="SecondaryRegionColor">#1B1B1B</Color>
    <Color x:Key="ThirdlyRegionColor">#424242</Color>

    <Color x:Key="BorderColor">#3F3F46</Color>
    <Color x:Key="SecondaryBorderColor">#555555</Color>

    <Color x:Key="PrimaryTextColor">#CCCCCC</Color>
    <Color x:Key="SecondaryTextColor">#757575</Color>
    <Color x:Key="ThirdlyTextColor">#3F3F46</Color>
    <Color x:Key="TextIconColor">#CCCCCC</Color>

    <!-- Resting button background. -->
    <Color x:Key="DefaultColor">#686868</Color>
    <Color x:Key="DarkDefaultColor">#686868</Color>

</ResourceDictionary>
